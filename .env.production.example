# ─── Next.js Frontend ──────────────────────────────────
# Public URL of the site (used by Next.js and NextAuth)
NEXT_PUBLIC_SITE_URL=http://46.224.229.114
NEXTAUTH_URL=http://46.224.229.114

# Generate with: openssl rand -hex 32
SECRET=changeme-replace-with-32-char-random-string

# The Go API base URL — uses the existing container name on bakend-prj_internal network
# This is used server-side (SSR), so it uses the internal Docker hostname
NEXT_PUBLIC_FIXPARTS_API_URL=http://fixparts-sync:8080
NEXT_PUBLIC_USE_FIXPARTS=true

# REST API endpoint (used by mock fallback, keep as-is)
NEXT_PUBLIC_REST_API_ENDPOINT=http://46.224.229.114/

# i18n
NEXT_PUBLIC_DEFAULT_LANGUAGE=en
NEXT_PUBLIC_ENABLE_MULTI_LANG=false
NEXT_PUBLIC_AVAILABLE_LANGUAGES=en

# NOTE: Database is managed by the existing fixparts-sync stack, not by this compose.
